# Muchhad Quiz — Environment Template
# Copy to .env and fill in your values
# NEVER commit .env files!

# ═══════════════════════════════════════════════════════════════════
# APP CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=development                    # development | production | test
PORT=4000                               # Backend port
CORS_ORIGIN=http://localhost:5173       # Frontend URL (comma-separated for multiple)

# ═══════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL 16+)
# ═══════════════════════════════════════════════════════════════════
# Local: postgresql://user:pass@localhost:5432/db
# Prod (Render): postgresql://user:pass@host:5432/db?sslmode=require
# Prod (Northflank): postgresql://user:pass@host:5432/db
DATABASE_URL=postgresql://muchhad:muchhad@localhost:5432/muchhad_quiz

# ═══════════════════════════════════════════════════════════════════
# REDIS (7+)
# ═══════════════════════════════════════════════════════════════════
# Local: redis://localhost:6379
# Prod: redis://host:6379 (or rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════
# AUTHENTICATION (JWT)
# ═══════════════════════════════════════════════════════════════════
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be 64+ characters for HS256
JWT_SECRET=your-64-character-cryptographically-random-secret-key-here-minimum-64-chars

# Token expiration
JWT_EXPIRES_IN=12h                      # Access token
JWT_REFRESH_EXPIRES_IN=7d               # Refresh token

# ═══════════════════════════════════════════════════════════════════
# PUBLIC HOST (Required for CORS, WebSocket, QR codes)
# ═══════════════════════════════════════════════════════════════════
# Local: http://localhost:5173
# Prod: https://your-domain.com
PUBLIC_HOST=http://localhost:5173

# ═══════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════
LOG_LEVEL=info                          # debug | info | warn | error

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL: MONITORING & ERROR TRACKING
# ═══════════════════════════════════════════════════════════════════
# Sentry DSN (get from sentry.io)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL: EMAIL (for notifications, password reset)
# ═══════════════════════════════════════════════════════════════════
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@your-domain.com

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL: FILE STORAGE (for exports, avatars)
# ═══════════════════════════════════════════════════════════════════
# S3_ENDPOINT=https://s3.your-provider.com
# S3_BUCKET=muchhad-quiz
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx
# S3_REGION=auto

# ═══════════════════════════════════════════════════════════════════
# FRONTEND ONLY (Vite env vars — prefix with VITE_)
# ═══════════════════════════════════════════════════════════════════
# Create frontend/.env with:
# VITE_API_URL=http://localhost:4000
# VITE_SOCKET_URL=http://localhost:4000

# ═══════════════════════════════════════════════════════════════════
# PRODUCTION OVERRIDES (set in production environment)
# ═══════════════════════════════════════════════════════════════════
# NODE_ENV=production
# CORS_ORIGIN=https://your-domain.com
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# REDIS_URL=redis://host:6379
# JWT_SECRET=production-64-char-secret
# PUBLIC_HOST=https://your-domain.com
# LOG_LEVEL=warn