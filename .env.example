# Muchhad-Quiz Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Backend Configuration
# ===========================================
NODE_ENV=production
PORT=4000

# CORS - Use * for all origins, or comma-separated list
CORS_ORIGIN=*

# Database (PostgreSQL)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://muchhadquiz:muchhadquiz_secret@localhost:5432/muchhadquiz

# Redis
# Format: redis://host:port or rediss:// for TLS
REDIS_URL=redis://localhost:6379

# JWT Secret - Generate with: openssl rand -hex 32
JWT_SECRET=your-64-character-random-string-here
JWT_EXPIRES_IN=12h

# Public Host for generating join URLs
# Set to your domain (e.g., Muchhad-Quiz.example.com) or Render URL
PUBLIC_HOST=localhost:8070

# ===========================================
# Frontend Configuration (Optional)
# ===========================================
# VITE_API_URL=http://localhost:4000

# Google Tag Manager / Google Analytics
# Get your GTM ID from https://tagmanager.google.com/
# Format: GTM-XXXXXXX or G-XXXXXXXXXX
# VITE_GTM_ID=